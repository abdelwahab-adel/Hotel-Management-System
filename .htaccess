# If your host points the domain at the project root instead of /public,
# this sends every request into the public/ front controller. For proper
# production hosting, prefer setting the DocumentRoot to /public directly
# (see docs/INSTALL.md) so app/, database/, storage/ etc. are never served.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ /public/$1 [L]
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
